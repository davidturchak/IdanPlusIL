# Copy to keystore.properties (gitignored) on the machine that cuts releases.
# Keep the .jks OUTSIDE the repository tree and back it up off-machine: every
# installed TV only accepts updates signed with this exact key.
storeFile=/root/.android-keys/idanplusil-release.jks
storePassword=change-me
keyAlias=idanplusil
keyPassword=change-me
